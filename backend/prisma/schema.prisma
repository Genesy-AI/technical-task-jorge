generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model lead {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  firstName   String
  lastName    String
  email       String
  jobTitle    String?
  countryCode String?
  companyName String?
  message     String?
  phoneNumber String?
  yearsAtCompany Int?
  linkedinUrl String?
  emailVerified Boolean?
  // null = never checked, otherwise: pending | verified | invalid | failed
  emailVerificationStatus String?
}
